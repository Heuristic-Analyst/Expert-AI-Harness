# Copy this file to .env and put your API keys here. Only the provider you actually use needs a value.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# the token of your Telegram bot (from @BotFather). only if you want to chat from your phone: clients/README.md
TELEGRAM_API_KEY=
# a fine-grained GitHub token. only if the agent should use GitHub: tools/github/README.md
GITHUB_API_KEY=
